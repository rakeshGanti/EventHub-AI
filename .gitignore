# This file is about which files and folders git ignores (node_modules, env files, build output).
# Dependencies
node_modules/
**/node_modules/

# Environment files
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Build output
.next/
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Playwright test artifacts
playwright-report/
test-results/
